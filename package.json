{
  "name": "@phanect/misc",
  "version": "2026.11.28",
  "description": "Monorepo for @phanect's personal configs",
  "author": "Jumpei Ogawa (https://phanective.org)",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "git@github.com:phanect/configs.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm build && tsc --noEmit && eslint && pnpm -r lint",
    "fix": "pnpm build && eslint --fix && pnpm -r --if-present fix",
    "test": "pnpm -r test",
    "release": "pnpm release:readme && pnpm build && pnpm --recursive publish --provenance --access=public",
    "release:readme": "jiti scripts/release-readme.ts",
    "versions": "jiti scripts/versions.ts",
    "clean": "git clean -dX --exclude=\"!mise.local.toml\" --force",
    "refresh": "pnpm clean && rm --force ./pnpm-lock.yaml && mise install"
  },
  "workspaces": [
    "projects/*",
    "examples/*"
  ],
  "devDependencies": {
    "@phanect/configs": "workspace:*",
    "@phanect/lint": "workspace:*",
    "@phanect/utils": "^4.0.0",
    "@types/eslint-plugin-jsx-a11y": "^6.9.0",
    "@types/node": "^24.3.0",
    "eslint": "^10.0.2",
    "jiti": "^2.5.1",
    "tsdown": "0.23.7",
    "type-fest": "^6.0.0",
    "typescript": "^6.0.2",
    "wrangler": "^4.85.0"
  },
  "engines": {
    "node": "22.x || 24.x || >=26.x"
  }
}
